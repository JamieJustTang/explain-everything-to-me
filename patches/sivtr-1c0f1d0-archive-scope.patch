+/// List sessions from the entire local archive, independently of registered
+/// workspaces. Bounds are applied before record blobs are decoded.
+pub fn list_archive_sessions(
+    conn: &Connection,
+    namespaces: &[&str],
+    cwd: Option<&Path>,
+    since: Option<&str>,
+    until: Option<&str>,
+) -> Result<Vec<ListedSession>> {
+    let browsing_key = cwd
+        .and_then(crate::workspace::repo_identity)
+        .unwrap_or_default();
+    let cwd_norm = cwd
+        .map(crate::agents::normalize_path_for_match)
+        .unwrap_or_default();
+    let no_workspace_filter = cwd.is_none() as i64;
+    let mut listed = Vec::new();
+    for namespace in namespaces {
+        let mut stmt = conn.prepare(
+            "SELECT id, source_path FROM sessions
+             WHERE provider = ?1
+               AND (?2 IS NULL OR julianday(COALESCE(ended_at, started_at, synced_at)) >= julianday(?2))
+               AND (?3 IS NULL OR julianday(COALESCE(started_at, ended_at, synced_at)) <= julianday(?3))
+               AND (?4 = 1 OR cwd_norm = ?5 OR (?6 != '' AND workspace_key = ?6))
+             ORDER BY mtime_secs DESC, mtime_nanos DESC, id DESC",
+        )?;
+        let rows = stmt.query_map(
+            params![
+                namespace,
+                since,
+                until,
+                no_workspace_filter,
+                cwd_norm,
+                browsing_key
+            ],
+            |row| {
+                Ok(ListedSession {
+                    row_id: row.get(0)?,
+                    provider: (*namespace).to_string(),
+                    source_path: row.get(1)?,
+                })
+            },
+        )?;
+        listed.extend(rows.collect::<std::result::Result<Vec<_>, _>>()?);
+    }
+    Ok(listed)
+}
+
+/// Count records whose event time is inside the requested window.
+pub fn archive_record_budget_in_window(
+    conn: &Connection,
+    session_row: i64,
+    since: Option<&str>,
+    until: Option<&str>,
+) -> Result<(i64, i64)> {
+    let budget = conn.query_row(
+        "SELECT COUNT(*), COALESCE(SUM(LENGTH(blob)), 0) FROM records WHERE session_row = ?1
+         AND (?2 IS NULL OR julianday(COALESCE(ended_at, started_at)) >= julianday(?2))
+         AND (?3 IS NULL OR julianday(COALESCE(ended_at, started_at)) <= julianday(?3))",
+        params![session_row, since, until],
+        |row| Ok((row.get(0)?, row.get(1)?)),
+    )?;
+    Ok(budget)
+}
+
+/// Decode only records in the requested event-time window from one session.
+pub fn load_archive_records_in_window(
+    conn: &Connection,
+    session_row: i64,
+    since: Option<&str>,
+    until: Option<&str>,
+    mode: BlobMode,
+) -> Result<Vec<WorkRecord>> {
+    let column = match mode {
+        BlobMode::Full => "blob",
+        BlobMode::Light => "blob_light",
+    };
+    let sql = format!(
+        "SELECT {column} FROM records WHERE session_row = ?1
+         AND (?2 IS NULL OR julianday(COALESCE(ended_at, started_at)) >= julianday(?2))
+         AND (?3 IS NULL OR julianday(COALESCE(ended_at, started_at)) <= julianday(?3))
+         ORDER BY idx ASC"
+    );
+    let mut stmt = conn.prepare(&sql)?;
+    let blobs = stmt.query_map(params![session_row, since, until], |row| {
+        row.get::<_, Vec<u8>>(0)
+    })?;
+    blobs
+        .map(|blob| {
+            let blob = blob?;
+            rmp_serde::from_slice(&blob).context("Failed to decode archived record blob")
+        })
+        .collect()
+}
