+/// Load a selector across every local session in the unified archive.
+/// This does not consult the workspace registry or remote mounts.
+pub fn load_archive_source(
+    source: &str,
+    mode: LoadMode,
+    cwd: Option<&Path>,
+    since: Option<&str>,
+    until: Option<&str>,
+) -> Result<SourceQueryResult> {
+    if since.is_none() && until.is_none() {
+        anyhow::bail!("archive search requires a time bound (--since, --until, or --last); search older history in bounded windows");
+    }
+    let selector: WorkRefSelector = source.parse()?;
+    let providers = selector.providers();
+    let sources = workspace_sources(&providers);
+    let namespaces: Vec<&str> = sources
+        .iter()
+        .map(|source| source.namespace())
+        .filter(|namespace| match selector {
+            WorkRefSelector::Terminal { .. } => *namespace == "terminal",
+            WorkRefSelector::Agent { .. } => *namespace != "terminal",
+        })
+        .collect();
+    let conn = crate::archive::open()?;
+    let sync_skipped = crate::archive::sync::ensure_fresh_with_conn(&conn)?;
+    let listed =
+        crate::archive::store::list_archive_sessions(&conn, &namespaces, cwd, since, until)?;
+    let mut skipped = Vec::new();
+    let mut count = 0;
+    let mut bytes = 0;
+    for session in &listed {
+        let (session_count, session_bytes) =
+            crate::archive::store::archive_record_budget_in_window(
+                &conn,
+                session.row_id,
+                since,
+                until,
+            )?;
+        count += session_count;
+        bytes += session_bytes;
+        if count > MAX_ARCHIVE_RECORDS || bytes > MAX_ARCHIVE_BLOB_BYTES {
+            anyhow::bail!("archive search window is too large to load safely; narrow the time window or provider");
+        }
+    }
+    let mut records = Vec::with_capacity(count as usize);
+    for session in &listed {
+        match crate::archive::store::load_archive_records_in_window(
+            &conn,
+            session.row_id,
+            since,
+            until,
+            mode.into(),
+        ) {
+            Ok(session_records) => records.extend(session_records),
+            Err(error) => skipped.push(SkippedSession {
+                namespace: session.provider.clone(),
+                path: PathBuf::from(&session.source_path),
+                error: format!("{error:#}"),
+            }),
+        }
+    }
+    skipped.extend(sync_skipped);
+    dedup_records(&mut records);
+    normalize_session_display_ids(&mut records);
+    records.retain(|record| selector.matches_work_ref(&record.work_ref));
+    records.sort_by(|a, b| b.time.primary_at().cmp(&a.time.primary_at()));
+    let anchors = records
+        .iter()
+        .map(|record| record.work_ref.whole())
+        .collect();
+    Ok(SourceQueryResult {
+        records,
+        anchors,
+        skipped,
+    })
+}
